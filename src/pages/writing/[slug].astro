---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { posts, parts, postDate } from '../../data/posts';
import { profile } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const paragraphs = post.body.split(/\n{2,}/);
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const link = 'class="text-fg underline decoration-outline hover:decoration-fg" target="_blank" rel="noopener noreferrer"';
const toHtml = (p: string) => parts(p).map((s) => ('href' in s ? `<a href="${s.href}" ${link}>${escape(s.label)}</a>` : escape(s.text))).join('');
const description = post.body.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/\s+/g, ' ').slice(0, 155).trim() + '…';
---

<Base title={`${post.title} — ${profile.name}`} description={description}>
  <main class="mx-auto w-full max-w-[880px] px-4 pt-[77px] pb-24">
    <header class="fade-in mb-20 flex items-center justify-between" style="--i:0">
      <a href="/" aria-label="Home"><Mark /></a>
      <a href="/#writing" class="text-muted hover:text-fg">← All writing</a>
    </header>

    <article class="max-w-[640px]">
      <p class="fade-in mb-4 text-muted tabular-nums" style="--i:1"><time datetime={post.date}>{postDate(post.date, 'long')}</time></p>
      <h1 class="fade-in mb-6 font-bold text-fg" style="--i:1">{post.title}</h1>

      <div class="fade-in mb-10 grid grid-cols-2 gap-3" style="--i:2">
        {
          post.images.map((img) => (
            <a href={img.src} target="_blank" class="block overflow-hidden rounded-[8px] border border-line">
              <img src={img.src} width={img.width} height={img.height} alt={img.alt} loading="eager" decoding="async" class="block h-auto w-full" />
            </a>
          ))
        }
      </div>

      <div class="fade-in" style="--i:3">
        {
          // Built as one string: whitespace-pre-line would show the newlines JSX puts around inline links.
          paragraphs.map((p) => <p class="mb-4 whitespace-pre-line text-muted" set:html={toHtml(p)} />)
        }
      </div>

      <a href={post.linkedin} target="_blank" rel="noopener noreferrer" class="mt-10 inline-block text-fg underline decoration-outline hover:decoration-fg">
        Originally posted on LinkedIn ↗
      </a>
    </article>
  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Section from '../components/Section.astro';
import Row from '../components/Row.astro';
import Activity from '../components/Activity.astro';
import CaseVideo from '../components/CaseVideo.astro';
import Portrait from '../components/Portrait.astro';
import Reviews from '../components/Reviews.astro';
import OverviewPlayer from '../components/OverviewPlayer.astro';
import IntroBubble from '../components/IntroBubble.astro';
import { profile, intro, links, upwork, experience, cases, reviews, earlier, webflow, show } from '../data/site';
---

<Base>
  <main class="mx-auto w-full max-w-[880px] px-4 pt-[77px] pb-16">
    <header class="fade-in mb-20 flex items-center justify-between" style="--i:0">
      <h1 class="sr-only">{profile.name} — {profile.role}</h1>
      <a href="/" aria-label="Home"><Mark /></a>
      <p class="text-muted tabular-nums" data-clock data-tz={profile.timezone}>&nbsp;</p>
    </header>

    <Section index={1}>
      <!-- Links sit at the bottom of the text column, level with the bottom of the photo. -->
      <div class="flex flex-col-reverse gap-8 sm:grid sm:grid-cols-[1fr_287px] sm:gap-12">
        <div class="flex flex-col">
          <p class="text-muted">
            {intro.hello} <span class="text-fg">{profile.short}</span>{intro.lead}
          </p>
          {intro.paragraphs.map((p) => <p class="mt-4 text-muted">{p}</p>)}
          <p class="mt-4 text-muted">{intro.based}</p>

          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 sm:mt-auto sm:pt-6">
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel="noopener noreferrer"
                    data-copy={l.href.startsWith('mailto:') ? profile.email : undefined}
                    class="text-fg underline decoration-outline hover:decoration-fg"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={profile.cv} target="_blank" rel="noopener noreferrer" class="text-fg underline decoration-outline hover:decoration-fg">CV ↗</a>
              <a href={profile.cvPdf} class="ml-1.5 text-muted hover:text-fg" download aria-label="Download CV as PDF">PDF ↓</a>
            </li>
          </ul>
          <p class="mt-2 text-muted">[ {upwork} ]</p>
        </div>
        <Portrait />
      </div>
    </Section>

    <Section index={2} title="Experience">
      {experience.map((e) => <Row title={e.company} subtitle={e.role} meta={e.years} />)}
    </Section>

    <Section index={3} title="Activity">
      <p class="mb-4 text-muted">What I’ve been shipping lately, straight from GitHub.</p>
      <Activity login={profile.github} />
    </Section>

    <Section index={4} title="Selected work" id="work">
      {
        cases.map((c) => (
          <article class="mb-16 last:mb-0">
            <p class="mb-4">
              <span class="text-muted">{c.year}</span>
              <span class="mx-1 text-muted">—</span>
              <span class="text-fg">{c.title}</span>
              <span class="text-muted"> · {c.tagline}</span>
            </p>
            <CaseVideo src={c.video} poster={c.poster} tint={c.tint} frame={c.frame} aspect={c.aspect} label={`${c.title} — ${c.tagline}`} />
            <p class="mt-4 text-muted">{c.text}</p>
            {c.overview === 'soon' && (
              <span class="mt-3 inline-flex items-center gap-2 text-muted">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
                  <circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 2.5" />
                  <path d="M6.5 5.5v5l4-2.5-4-2.5Z" fill="currentColor" />
                </svg>
                Overview video coming soon
              </span>
            )}
            {c.overview && c.overview !== 'soon' && (
              <a href={c.overview} target="_blank" rel="noopener noreferrer" data-overview={`${c.title} · Overview`} class="group mt-3 inline-flex items-center gap-2 text-fg">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
                  <circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.5" />
                  <path d="M6.5 5.5v5l4-2.5-4-2.5Z" fill="currentColor" />
                </svg>
                <span class="underline decoration-outline group-hover:decoration-fg">Watch overview</span>
              </a>
            )}
          </article>
        ))
      }
    </Section>

    {
      show.reviews && (
        <Section index={5} title="Kind words" id="reviews">
          <Reviews items={reviews} />
          <a
            href={links.find((l) => l.label === 'Upwork')!.href}
            target="_blank"
            rel="noopener noreferrer"
            class="relative -mt-6 inline-block text-fg underline decoration-outline hover:decoration-fg"
          >
            See all reviews on Upwork ↗
          </a>
        </Section>
      )
    }

    <Section index={show.reviews ? 6 : 5} title="Earlier work">
      {
        earlier.map((e) => (
          <Row title={e.title} subtitle={e.text} meta={e.year}>
            <p class="mt-1 flex gap-4">
              {e.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-fg underline decoration-outline hover:decoration-fg">
                  {l.label} ↗
                </a>
              ))}
            </p>
          </Row>
        ))
      }
      <OverviewPlayer />
    </Section>

    <Section index={show.reviews ? 7 : 6} title="Webflow builds">
      {webflow.map((w) => <Row title={w.title} subtitle={w.text} meta="↗" href={w.href} />)}
    </Section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex w-full max-w-[880px] items-center justify-between px-4 py-12">
      <a href={`mailto:${profile.email}`} data-copy={profile.email} class="hover:underline">{profile.email}</a>
      <span class="text-muted">© {new Date().getFullYear()}</span>
    </div>
  </footer>

  <IntroBubble />
</Base>

<script>
  // Email links copy the address instead of launching a mail app; ⌘/Ctrl-click still opens mailto.
  document.querySelectorAll<HTMLAnchorElement>('a[data-copy]').forEach((a) => {
    const label = a.textContent;
    let timer = 0;
    a.addEventListener('click', async (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(a.dataset.copy!);
      } catch {
        location.href = a.href; // clipboard blocked — open mailto instead
        return;
      }
      a.textContent = 'Copied ✓';
      clearTimeout(timer);
      timer = window.setTimeout(() => (a.textContent = label), 1600);
    });
  });

  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const timeZone = el.dataset.tz;
    const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone });
    const offset = new Intl.DateTimeFormat('en-GB', { timeZoneName: 'shortOffset', timeZone });
    // Kyiv is EET (UTC+2) in winter and EEST (UTC+3) in summer; derive it from the live offset.
    const zone = (d: Date) => {
      const utc = (offset.formatToParts(d).find((p) => p.type === 'timeZoneName')?.value ?? 'GMT+2').replace('GMT', 'UTC');
      return `${utc === 'UTC+3' ? 'EEST' : 'EET'} (${utc})`;
    };
    const tick = () => {
      const now = new Date();
      el.textContent = `${time.format(now)} ${zone(now)}`;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>

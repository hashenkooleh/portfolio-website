---
// Strip of post images, fading out at the container edges, drifting slowly left → right (framer.com style).
// Every image links to its post. The set is repeated so the loop never shows a gap:
// the track holds two identical halves and slides by exactly one half.
import { posts } from '../data/posts';

const HEIGHT = 240;
// Interleave posts so neighbours differ: 1st image of each post, then the 2nd.
const set = [0, 1].flatMap((i) => posts.flatMap((p) => (p.images[i] ? [{ ...p.images[i], slug: p.slug, title: p.title }] : [])));
const half = [...set, ...set]; // wide enough for big screens
---

<div class="carousel overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]">
  <div class="track flex w-max">
    {
      [half, half].map((items, copy) => (
        <ul class="flex shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((img) => (
            <li class="pr-3">
              <a
                href={`/writing/${img.slug}`}
                tabindex={copy === 1 ? -1 : undefined}
                class="group block rounded-[14px] border border-line bg-[#0a0a0a] p-1.5 transition-colors hover:border-outline"
                aria-label={img.title}
              >
                <img
                  src={img.src}
                  alt=""
                  width={Math.round((img.width / img.height) * HEIGHT)}
                  height={HEIGHT}
                  loading="lazy"
                  decoding="async"
                  class="block rounded-[9px] opacity-85 transition-opacity duration-300 group-hover:opacity-100"
                  style={`height:${HEIGHT}px;width:auto`}
                />
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  /* Moves right: starts shifted one half to the left and slides back to 0. */
  .track {
    animation: drift 90s linear infinite;
  }
  .carousel:hover .track {
    animation-play-state: paused;
  }
  @keyframes drift {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .carousel {
      overflow-x: auto;
    }
  }
</style>

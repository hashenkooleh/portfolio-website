---
import { getActivity, type Day } from '../lib/github';

interface Props {
  login: string;
  months?: number; // whole calendar months to show, including the current one
}

const { login, months: span = 6 } = Astro.props;
const full = await getActivity(login);

// Start on the 1st of the month `span - 1` months back, so every month is shown whole.
const latest = full?.weeks.at(-1)?.at(-1)?.date;
const start = (() => {
  if (!latest) return '';
  const d = new Date(latest);
  return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() - (span - 1), 1)).toISOString().slice(0, 10);
})();
const weeks = full ? full.weeks.filter((w) => w.at(-1)!.date >= start) : [];
const inRange = (d: Day) => d.date >= start;
const total = weeks.flat().filter(inRange).reduce((sum, d) => sum + d.count, 0);

const shades = ['#161616', '#3a3a3a', '#6b6b6b', '#a8a8a8', '#ffffff'];
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Label the week that holds the 1st of each month.
const labels = weeks.map((week) => {
  const first = week.find((d) => inRange(d) && new Date(d.date).getUTCDate() === 1);
  return first ? months[new Date(first.date).getUTCMonth()] : '';
});

const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{
  full ? (
    <div>
      <div class="grid gap-[3px] sm:gap-1" style={`grid-template-columns: repeat(${weeks.length}, minmax(0, 1fr))`}>
        {labels.map((label) => (
          <span class="h-5 overflow-visible whitespace-nowrap text-[11px] leading-4 text-muted">{label}</span>
        ))}
        {weeks.map((week, w) => (
          <div class="grid grid-rows-7 gap-[3px] sm:gap-1" style={`grid-column:${w + 1}; grid-row:2`}>
            {week.map((day) =>
              inRange(day) ? (
                <span
                  class="aspect-square rounded-[2px] sm:rounded-[4px]"
                  style={`background:${shades[day.level]}; grid-row:${new Date(day.date).getUTCDay() + 1}`}
                  title={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${fmt.format(new Date(day.date))}`}
                />
              ) : (
                <span class="aspect-square" style={`grid-row:${new Date(day.date).getUTCDay() + 1}`} />
              ),
            )}
          </div>
        ))}
      </div>
      <div class="mt-4 flex items-center justify-between gap-4 text-muted">
        <a href={`https://github.com/${login}`} target="_blank" rel="noopener noreferrer" class="hover:text-fg hover:underline">
          {total.toLocaleString('en')} contributions in the last {span} months
        </a>
        <span class="flex shrink-0 items-center gap-[3px] text-[11px]" aria-hidden="true">
          less
          {shades.map((c) => <span class="size-[10px] rounded-[2px]" style={`background:${c}`} />)}
          more
        </span>
      </div>
    </div>
  ) : (
    <p class="text-muted">
      Activity is unavailable right now —{' '}
      <a href={`https://github.com/${login}`} class="text-fg underline">see it on GitHub</a>.
    </p>
  )
}

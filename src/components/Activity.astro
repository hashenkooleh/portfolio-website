---
import { getActivity } from '../lib/github';

interface Props {
  login: string;
  months?: number; // how far back to show
}

const { login, months: span = 6 } = Astro.props;
const full = await getActivity(login);

// Keep only the last `span` months (~4.35 weeks each) and recount the total.
const activity = full && {
  weeks: full.weeks.slice(-Math.round(span * 4.35)),
  get total() {
    return this.weeks.flat().reduce((sum, d) => sum + d.count, 0);
  },
};
const period = span === 12 ? 'the last year' : `the last ${span} months`;
const cell = 16; // px; gap is 4px

const shades = ['#161616', '#3a3a3a', '#6b6b6b', '#a8a8a8', '#ffffff'];
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Month label sits above the first week of each month, if the month has room for it.
const monthOf = (i: number) => (activity?.weeks[i] ? new Date(activity.weeks[i][0].date).getUTCMonth() : -1);
const labels =
  activity?.weeks.map((_, i) => {
    const month = monthOf(i);
    return month !== monthOf(i - 1) && month === monthOf(i + 2) ? months[month] : '';
  }) ?? [];

const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{
  activity ? (
    <div>
      <div class="activity-scroll -mx-1 overflow-x-auto px-1 pb-2" data-activity>
        <div class="inline-grid gap-1" style={`grid-template-columns: repeat(${activity.weeks.length}, ${cell}px)`}>
          {labels.map((label) => (
            <span class="h-4 overflow-visible whitespace-nowrap text-[11px] leading-4 text-muted">{label}</span>
          ))}
          {activity.weeks.map((week, w) => (
            <div class="grid grid-rows-7 gap-1" style={`grid-column:${w + 1}; grid-row:2`}>
              {week.map((day) => (
                <span
                  class="rounded-[3px]"
                  style={`width:${cell}px; height:${cell}px; background:${shades[day.level]}; grid-row:${new Date(day.date).getUTCDay() + 1}`}
                  title={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${fmt.format(new Date(day.date))}`}
                />
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="mt-3 flex items-center justify-between gap-4 text-muted">
        <a href={`https://github.com/${login}`} target="_blank" rel="noopener noreferrer" class="hover:text-fg hover:underline">
          {activity.total.toLocaleString('en')} contributions in {period}
        </a>
        <span class="flex shrink-0 items-center gap-[3px] text-[11px]" aria-hidden="true">
          less
          {shades.map((c) => <span class="size-[10px] rounded-[2px]" style={`background:${c}`} />)}
          more
        </span>
      </div>
    </div>
  ) : (
    <p class="text-muted">
      Activity is unavailable right now —{' '}
      <a href={`https://github.com/${login}`} class="text-fg underline">see it on GitHub</a>.
    </p>
  )
}

<script>
  // On narrow screens show the most recent weeks first.
  document.querySelectorAll<HTMLElement>('[data-activity]').forEach((el) => {
    el.scrollLeft = el.scrollWidth;
  });
</script>

<style>
  .activity-scroll {
    scrollbar-width: none;
  }
  .activity-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

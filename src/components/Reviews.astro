---
// Masonry of quote cards. Each card rises in as it scrolls into view.
interface Review {
  quote: string;
  author: string;
  company: string;
  source?: string;
}

interface Props {
  items: Review[];
}

const { items } = Astro.props;

// "**phrase**" in a quote is lifted to full white; the rest stays muted.
const parts = (q: string) => q.split(/\*\*(.+?)\*\*/g).map((text, i) => ({ text, hi: i % 2 === 1 }));
---

<!-- Bottom fades into the page so it reads as "there's more below". -->
<div class="columns-1 gap-4 [mask-image:linear-gradient(to_bottom,black_calc(100%-160px),transparent)] sm:columns-2">
  {
    items.map((r, i) => (
      <figure
        class="review mb-4 break-inside-avoid rounded-xl border border-line bg-[#0a0a0a] p-6 transition-colors duration-300 hover:border-outline"
        style={`--d:${(i % 2) * 90}ms`}
        data-review
      >
        <p class="mb-4 flex items-center gap-2 text-muted" aria-label="Rated 5 out of 5">
          <span class="flex gap-0.5 text-fg" aria-hidden="true">
            {Array.from({ length: 5 }, () => (
              <svg width="14" height="14" viewBox="0 0 16 16" class="star">
                <path d="M8 1.2l2.1 4.3 4.7.7-3.4 3.3.8 4.7L8 12l-4.2 2.2.8-4.7L1.2 6.2l4.7-.7L8 1.2Z" fill="currentColor" />
              </svg>
            ))}
          </span>
          5.0
        </p>
        <blockquote class="text-muted">
          “{parts(r.quote).map((p) => (p.hi ? <span class="text-fg">{p.text}</span> : p.text))}”
        </blockquote>
        <figcaption class="mt-6 flex items-baseline justify-between gap-4 text-muted">
          <span>
            <span class="text-fg">{r.author}</span> · {r.company}
          </span>
          {r.source && <span class="shrink-0">{r.source}</span>}
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .review {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d),
      border-color 0.3s;
  }
  .review.is-in {
    opacity: 1;
    transform: none;
  }
  /* On hover the stars softly turn gold, all together. */
  .star {
    transition: color 0.4s ease;
  }
  .review:hover .star {
    color: #f2c14e;
  }
  @media (prefers-reduced-motion: reduce) {
    .review {
      opacity: 1;
      transform: none;
      transition: border-color 0.3s;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-review]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  cards.forEach((c) => io.observe(c));
</script>
